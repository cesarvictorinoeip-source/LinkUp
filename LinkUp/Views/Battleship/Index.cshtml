@using LinkUp.Core.Application.Dtos.Battleship.Game
@using LinkUp.Core.Application.Dtos.Battleship.Friendship
@{
    ViewData["Title"] = "Battleship";
    var activeGames = ViewBag.ActiveGames as List<GameDto>;
    var history = ViewBag.History as List<GameDto>;
    var friends = ViewBag.Friends as List<FriendshipDto>;
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="container mt-4">
    <h3 class="mb-4">Battleship</h3>

    <div class="row">
        <!-- Nueva partida -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Nueva Partida</h5>
                </div>
                <div class="card-body">
                    @if (friends == null || !friends.Any())
                    {
                        <p class="text-muted">No tienes amigos para jugar.</p>
                    }
                    else
                    {
                        <form asp-action="Create" method="post">
                            <div class="mb-3">
                                <label class="form-label">Selecciona un oponente:</label>
                                @foreach (var f in friends)
                                {
                                    var friendName = f.IdUserOne == currentUserId ? f.UserTwoName : f.UserOneName;
                                    var friendId = f.IdUserOne == currentUserId ? f.IdUserTwo : f.IdUserOne;
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="opponentId" value="@friendId" />
                                        <label class="form-check-label">@friendName</label>
                                    </div>
                                }
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Crear partida</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Partidas activas -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Partidas Activas</h5>
                </div>
                <div class="card-body">
                    @if (activeGames == null || !activeGames.Any())
                    {
                        <p class="text-muted">No tienes partidas activas.</p>
                    }
                    else
                    {
                        @foreach (var g in activeGames)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div>
                                    <strong>vs @(g.Player1Id == currentUserId ? g.Player2Name : g.Player1Name)</strong>
                                    <span class="badge @(g.CurrentTurnPlayerId == currentUserId ? "bg-success" : "bg-secondary") ms-2">
                                        @(g.CurrentTurnPlayerId == currentUserId ? "Tu turno" : "Turno del oponente")
                                    </span>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (g.Status == "Waiting")
                                    {
                                        <a asp-action="PlaceShips" asp-route-gameId="@g.Id" class="btn btn-warning btn-sm">Colocar barcos</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Play" asp-route-gameId="@g.Id" class="btn btn-primary btn-sm">Jugar</a>
                                    }
                                    <form asp-action="Surrender" method="post" style="display:inline">
                                        <input type="hidden" name="gameId" value="@g.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">Rendirse</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Historial -->
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Historial</h5>
                </div>
                <div class="card-body">
                    @if (history == null || !history.Any())
                    {
                        <p class="text-muted">No hay partidas finalizadas.</p>
                    }
                    else
                    {
                        @foreach (var g in history)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div>
                                    <strong>vs @(g.Player1Id == currentUserId ? g.Player2Name : g.Player1Name)</strong>
                                    <span class="badge @(g.WinnerId == currentUserId ? "bg-success" : "bg-danger") ms-2">
                                        @(g.WinnerId == currentUserId ? "Ganaste" : "Perdiste")
                                    </span>
                                </div>
                                <a asp-action="GameDetail" asp-route-gameId="@g.Id" class="btn btn-outline-secondary btn-sm">Ver detalle</a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>