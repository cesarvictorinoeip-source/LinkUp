@using LinkUp.Core.Application.Dtos.Battleship.Post
@model List<PostDto>
@{
    ViewData["Title"] = "Amigos";
    var friends = ViewBag.Friends as List<LinkUp.Core.Application.Dtos.Battleship.Friendship.FriendshipDto>;
    var currentUserId = ViewBag.CurrentUserId as string;
}
<div class="container mt-4">
    <div class="row">
        <!-- Publicaciones de amigos -->
        <div class="col-md-8">
            <h4 class="mb-3">Publicaciones de mis amigos</h4>
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">No hay publicaciones de amigos aún.</div>
            }
            else
            {
                @foreach (var post in Model)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <img src="@(string.IsNullOrEmpty(post.AuthorImage) ? "https://via.placeholder.com/40" : post.AuthorImage)"
                                     class="rounded-circle me-2" width="40" height="40" />
                                <div>
                                    <a asp-action="FriendPosts" asp-route-friendId="@post.UserId" class="fw-bold text-decoration-none">
                                        @post.AuthorName
                                    </a>
                                    <small class="text-muted d-block">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                            <p>@post.Content</p>
                            @if (!string.IsNullOrEmpty(post.ImagePath))
                            {
                                <img src="@post.ImagePath" class="img-fluid rounded" />
                            }
                            @if (!string.IsNullOrEmpty(post.YoutubeUrl))
                            {
                                <div class="ratio ratio-16x9 mt-2">
                                    <iframe src="@post.YoutubeUrl.Replace("watch?v=", "embed/")" allowfullscreen></iframe>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        <!-- Lista de amigos -->
        <div class="col-md-4">
            <h4 class="mb-3">Mis amigos</h4>
            @if (friends == null || !friends.Any())
            {
                <div class="alert alert-info">No tienes amigos agregados aún.</div>
            }
            else
            {
                @foreach (var f in friends)
                {
                    var friendName = f.IdUserOne == currentUserId ? f.UserTwoName : f.UserOneName;
                    var friendId = f.IdUserOne == currentUserId ? f.IdUserTwo : f.IdUserOne;
                    <div class="card mb-2 shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <a asp-action="FriendPosts" asp-route-friendId="@friendId" class="fw-bold text-decoration-none">
                                    @friendName
                                </a>
                            </div>
                            <a asp-action="Remove" asp-route-friendshipId="@f.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>