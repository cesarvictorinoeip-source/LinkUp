@{
    ViewData["Title"] = "Eliminar Amigo";
}
<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width:500px">
        <div class="card-body text-center">
            <h5 class="mb-3">¿Está seguro que desea eliminar a <strong>@ViewBag.FriendName</strong> de tus amigos?</h5>
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <form asp-action="RemoveConfirmed" method="post">
                    <input type="hidden" name="friendshipId" value="@ViewBag.FriendshipId" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>