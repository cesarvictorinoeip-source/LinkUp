@model LinkUp.Core.Application.ViewModels.User.SaveUserViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Mi Perfil</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="User" asp-action="Profile" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Apellido</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Teléfono</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Foto de perfil</label>
                            @if (!string.IsNullOrEmpty(Model?.ProfileImage))
                            {
                                <div class="mb-2">
                                    <img src="@Model.ProfileImage" class="rounded-circle" width="80" height="80" />
                                </div>
                            }
                            <input type="file" asp-for="ProfileImageFile" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nueva contraseña (opcional)</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Dejar en blanco para no cambiar" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirmar contraseña</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model?.Error))
                        {
                            <div class="alert alert-danger">@Model.Error</div>
                        }

                        <div class="d-flex gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>