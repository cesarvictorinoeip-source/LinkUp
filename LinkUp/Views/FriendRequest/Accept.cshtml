@{
    ViewData["Title"] = "Aceptar Solicitud";
}
<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width:500px">
        <div class="card-body text-center">
            <h5 class="mb-3">¿Está seguro que desea aceptar la solicitud de amistad del usuario <strong>@ViewBag.SenderName</strong>?</h5>
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <form asp-action="AcceptConfirmed" method="post">
                    <input type="hidden" name="id" value="@ViewBag.FriendshipId" />
                    <button type="submit" class="btn btn-success">Aceptar</button>
                </form>
            </div>
        </div>
    </div>
</div>