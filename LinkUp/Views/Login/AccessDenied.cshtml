@using Microsoft.AspNetCore.Identity


@{
    ViewData["Title"] = "Acceso Denegado";

    // Determinamos si el usuario es Admin para saber a qué Home enviarlo
    bool isAdmin = User.IsInRole("Admin");

    // Si no es admin, podrías usar un Layout distinto si lo tienes (ej: _LayoutUser)
    if (!isAdmin)
    {
        // Layout = "_LayoutUser"; // Descomenta si tienes un layout especial
    }
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <h1 class="display-1 text-danger"><i class="bi bi-shield-lock-fill"></i></h1>
                    <h2 class="fw-bold">Acceso Denegado</h2>
                    <p class="text-muted mb-4">
                        Lo sentimos, tu usuario no tiene los permisos necesarios para acceder a esta sección del sistema.
                    </p>
                    <hr />
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">
                            <i class="bi bi-house-door"></i> Ir al Inicio
                        </a>
                        <form asp-controller="Login" asp-action="LogOut" method="post">
                            <button type="submit" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>