@model IEnumerable<LinkUp.Core.Application.Dtos.Battleship.Post.PostDto>
@{
    ViewData["Title"] = "Muro Social";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">¿Qué tienes en mente?</h5>
                    <form asp-controller="Home" asp-action="CreatePost" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <textarea name="Content" class="form-control" rows="3" placeholder="Escribe algo..."></textarea>
                        </div>
                        <div class="row">
                            <div class="col">
                                <input type="text" name="YoutubeUrl" class="form-control form-control-sm" placeholder="URL de YouTube (opcional)">
                            </div>
                            <div class="col">
                                <input type="file" name="ImageFile" class="form-control form-control-sm">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3 w-100">Publicar</button>
                    </form>
                </div>
            </div>
            @foreach (var post in Model)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white d-flex align-items-center">
                        <img src="@(string.IsNullOrEmpty(post.AuthorImage) ? "https://via.placeholder.com/40" : post.AuthorImage)"
                             class="rounded-circle me-2" width="40" height="40" alt="Perfil">
                        <div>
                            <h6 class="mb-0">@post.AuthorName</h6>
                            <small class="text-muted">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@post.Content</p>
                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <img src="@post.ImageUrl" class="img-fluid rounded mb-3" alt="Imagen del post">
                        }
                        @if (!string.IsNullOrEmpty(post.YoutubeUrl))
                        {
                            <div class="ratio ratio-16x9">
                                <iframe src="@post.YoutubeUrl.Replace("watch?v=", "embed/")" title="YouTube video" allowfullscreen></iframe>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white">
                        <button class="btn btn-sm btn-outline-secondary">Comentar</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>