@model LinkUp.Core.Application.ViewModels.User.ForgotPasswordRequestViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h5 class="mb-0"><i class="bi bi-person-lock"></i> ¿Olvidaste tu contraseña?</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Login" asp-action="ForgotPassword" method="POST">
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold">Correo Electrónico:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input class="form-control" asp-for="Email" placeholder="ejemplo@correo.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Login" asp-action="Index" class="btn btn-link text-decoration-none">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send"></i> Enviar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>