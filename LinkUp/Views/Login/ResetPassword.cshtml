@using LinkUp.Core.Application.ViewModels.User
@model ResetPasswordRequestViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Nueva Contraseña</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        Por favor, ingresa tu nueva contraseña para recuperar el acceso a tu cuenta.
                    </p>

                    @if (ViewBag.HasError != null && ViewBag.HasError)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <ul class="mb-0 small">
                                @foreach (var error in ViewBag.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Login" asp-action="ResetPassword" method="POST">
                        @* CAMPOS OCULTOS: Vitales para que el proceso no falle *@
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="Email" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">Nueva Contraseña:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="password" class="form-control" asp-for="Password" placeholder="Mínimo 6 caracteres" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirmar Contraseña:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-check2-circle"></i></span>
                                <input type="password" class="form-control" asp-for="ConfirmPassword" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Guardar Cambios
                            </button>
                            <a asp-controller="Login" asp-action="Index" class="btn btn-link text-decoration-none text-center">
                                <i class="bi bi-arrow-left"></i> Cancelar y volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            <div class="text-center mt-3">
                <small class="text-muted">&copy; 2026 - LinkUp</small>
            </div>
        </div>
    </div>
</div>