@model List<LinkUp.Core.Application.ViewModels.User.UserViewModel>
@{
    ViewData["Title"] = "Nueva Solicitud";
}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Nueva Solicitud de Amistad</h5>
        </div>
        <div class="card-body">
            <form asp-action="New" method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Buscar por nombre de usuario..." />
                    <button type="submit" class="btn btn-primary">Buscar</button>
                </div>
            </form>

            <form asp-action="Send" method="post">
                @if (Model == null || !Model.Any())
                {
                    <p class="text-muted">No hay usuarios disponibles.</p>
                }
                else
                {
                    @foreach (var u in Model)
                    {
                        <div class="d-flex align-items-center border-bottom py-2">
                            <input type="radio" name="receiverId" value="@u.Id" class="me-3" />
                            <img src="@(string.IsNullOrEmpty(u.ProfileImage) ? "https://via.placeholder.com/40" : u.ProfileImage)"
                                 class="rounded-circle me-2" width="40" height="40" />
                            <strong>@u.UserName</strong>
                        </div>
                    }
                }
                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                    <button type="submit" class="btn btn-primary">Enviar solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>