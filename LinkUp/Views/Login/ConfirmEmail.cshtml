@model string

@{
    ViewData["Title"] = "Confirmación de Cuenta";
    // Usamos el layout principal o uno anónimo si lo tienes configurado
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h5 class="mb-0"><i class="bi bi-check-circle-fill"></i> Verificación de Correo</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="alert alert-info border-0 shadow-sm mb-4" role="alert">
                        <h4 class="alert-heading">¡Estado de la operación!</h4>
                        <p class="mb-0">@Model</p>
                    </div>

                    <p class="text-muted">Ya puedes acceder a todas las funcionalidades de LinkUp.</p>

                    <div class="d-grid mt-4">
                        <a class="btn btn-success btn-lg" asp-controller="Login" asp-action="Index">
                            <i class="bi bi-box-arrow-in-right"></i> Ir al Inicio de Sesión
                        </a>
                    </div>
                </div>
            </div>
            <div class="text-center mt-3">
                <small class="text-muted">&copy; 2026 - LinkUp</small>
            </div>
        </div>
    </div>
</div>