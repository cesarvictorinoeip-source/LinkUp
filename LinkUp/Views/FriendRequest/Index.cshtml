@{
    ViewData["Title"] = "Solicitudes de Amistad";
    var received = ViewBag.Received as List<LinkUp.Core.Application.Dtos.Battleship.Friendship.FriendshipDto>;
    var sent = ViewBag.Sent as List<LinkUp.Core.Application.Dtos.Battleship.Friendship.FriendshipDto>;
}

<div class="container mt-4">
    <h3 class="mb-4">Solicitudes de Amistad</h3>

    <!-- Solicitudes recibidas -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Solicitudes recibidas</h5>
        </div>
        <div class="card-body">
            @if (received == null || !received.Any())
            {
                <p class="text-muted">No tienes solicitudes pendientes.</p>
            }
            else
            {
                @foreach (var r in received)
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                        <div>
                            <strong>@r.UserOneName</strong>
                            <small class="text-muted ms-2">@r.CreatedAt.ToString("dd/MM/yyyy")</small>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Accept" asp-route-id="@r.Id" class="btn btn-success btn-sm">Aceptar</a>
                            <a asp-action="Reject" asp-route-id="@r.Id" class="btn btn-danger btn-sm">Rechazar</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Solicitudes enviadas -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Solicitudes enviadas</h5>
            <a asp-action="New" class="btn btn-light btn-sm">Nueva solicitud</a>
        </div>
        <div class="card-body">
            @if (sent == null || !sent.Any())
            {
                <p class="text-muted">No has enviado solicitudes.</p>
            }
            else
            {
                @foreach (var s in sent)
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                        <div>
                            <strong>@s.UserTwoName</strong>
                            <small class="text-muted ms-2">@s.CreatedAt.ToString("dd/MM/yyyy")</small>
                            <span class="badge bg-warning text-dark ms-2">En espera</span>
                        </div>
                        <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </div>
                }
            }
        </div>
    </div>
</div>